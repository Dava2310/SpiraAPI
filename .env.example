# ============================================================================
# Spira API — environment
#
# Copy to `.env` and fill in. Everything below is read by the code unless a
# block says otherwise. See docs/deployment.md for the deployment walkthrough.
#
# Two local setups:
#   Docker Postgres (docker-compose.db.yml)  -> the defaults here work as-is
#   Supabase / Neon / RDS                    -> see "Managed provider" below
# ============================================================================


# ----------------------------------------------------------------------------
# Server
# ----------------------------------------------------------------------------

# Port the API listens on. Falls back to 5000 if unset. Render, Railway and most
# PaaS inject their own value — leave it to them in deployed environments.
PORT = 3333

# Space-separated list of allowed browser origins. `*` allows any, which is fine
# locally and wrong in production. Set this to the real frontend URLs.
CORS_ORIGIN = 'http://localhost:3000 http://localhost:4200 http://localhost:5173'


# ----------------------------------------------------------------------------
# Authentication
# ----------------------------------------------------------------------------

# Signs and verifies access tokens. CHANGE THIS before deploying — the fallback
# in code is the literal string 'secret'. Rotating it revokes every live session.
# Generate one with:  openssl rand -base64 48
ACCESS_TOKEN_SECRET = 'change-me-to-a-long-random-string'

# Reserved for refresh tokens, which are not implemented yet. Set it now so the
# value does not have to change later.
REFRESH_TOKEN_SECRET = 'change-me-too-and-keep-it-different'

# Token lifetimes are currently hardcoded in src/config/jwt.config.ts
# (access 2h, refresh 4h). There is no environment variable for them yet.


# ----------------------------------------------------------------------------
# Database — connection
#
# DATABASE_URL takes precedence over the POSTGRES_* variables below. Comment it
# out to fall back to them.
#
# The password must be URL-encoded: @ -> %40, # -> %23, / -> %2F, : -> %3A.
#
# Do NOT append `?sslmode=require`. TypeORM discards the query string before the
# driver sees it, so it has no effect. Use DB_SSL instead.
# ----------------------------------------------------------------------------

# --- Local Docker (docker compose -f docker-compose.db.yml up -d --wait) ---
DATABASE_URL = "postgresql://spira:spira_secret@localhost:5433/spira_db"

# --- Managed provider: Supabase ---
# Use the SESSION pooler on port 5432. The transaction pooler (6543) does not
# support prepared statements and will break migrations. The direct connection
# (db.<ref>.supabase.co) is IPv6-only and fails on IPv4-only networks.
# Note the username is postgres.<project-ref>, not postgres.
#
# DATABASE_URL = "postgresql://postgres.<project-ref>:<url-encoded-password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# --- Managed provider: Neon ---
# DATABASE_URL = "postgresql://<user>:<password>@<endpoint>.<region>.aws.neon.tech/<db>"


# ----------------------------------------------------------------------------
# Database — TLS
# ----------------------------------------------------------------------------

# Enables TLS. Required by every managed provider (Supabase, Neon, Heroku, RDS
# with rds.force_ssl). Must stay false for the local Docker container, which
# runs with ssl=off and will reject an encrypted connection.
# Reverse-proxy hops in front of the app, so rate limiting sees the real client IP.
# Set to 1 on Render or behind one proxy. Leave unset when the app is exposed
# directly — trusting a header nobody strips lets a caller spoof its own address.
TRUST_PROXY_HOPS = 1

DB_SSL = true

# Verify the server certificate against the trust store. Most managed providers
# present a chain that is not in the system CA store, so this stays false and
# the connection is encrypted but unauthenticated.
#
# For a fully verified connection: download the provider's CA certificate
# (Supabase: Project Settings -> Database -> SSL Configuration), put it in
# DB_SSL_CA, and set this to true.
DB_SSL_REJECT_UNAUTHORIZED = false
# DB_SSL_CA = "-----BEGIN CERTIFICATE-----\nMIID...\n-----END CERTIFICATE-----"


# ----------------------------------------------------------------------------
# Database — schema management
# ----------------------------------------------------------------------------

# `synchronize` builds the schema from the entity classes on every boot. Handy
# against a throwaway local database, and UNUSABLE anywhere else: it cannot add
# a value to an enum shared by two columns and fails with SQLSTATE 42710.
#
# MUST be false on every deployed environment. Use migrations there:
#   pnpm migration:run        (local, via tsx)
#   pnpm migration:run:prod   (deployed, from compiled dist/)
DB_SYNCHRONIZE = false

# Logs every SQL statement. Useful when debugging a query, far too noisy
# otherwise.
DB_LOGGING = false


# ----------------------------------------------------------------------------
# Docker Compose — Postgres provisioning
#
# Read by docker-compose.db.yml to create the container, and by the API only
# when DATABASE_URL is commented out. POSTGRES_PORT is NOT read by the compose
# file: the host port is fixed at 5433 there to avoid clashing with a local
# Postgres on 5432.
# ----------------------------------------------------------------------------

POSTGRES_USER = spira
POSTGRES_PASSWORD = spira_secret
POSTGRES_DB = spira_db
POSTGRES_HOST = localhost
POSTGRES_PORT = 5433


# ----------------------------------------------------------------------------
# Not wired to any code yet
#
# These are read by nothing today. Kept as a record of what the product will
# need — email verification, password reset and notification delivery are all
# outstanding work. Setting them has no effect.
# ----------------------------------------------------------------------------

# SMTP_HOST = 'smtp.resend.com'
# SMTP_PORT = 465
# SMTP_USER = ''
# SMTP_PASS = ''
# SMTP_FROM = 'Spira <no-reply@spira.app>'
# SMTP_SECURE = true
