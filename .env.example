PORT = 3333

# SMTP
SMTP_HOST = 'smtp.gmail.com'
SMTP_PORT = 465
SMTP_USER = 'test@gmail.com'
SMTP_PASS = 'test'
SMTP_FROM = '"TEST <test@gmail.com>'
SMTP_SECURE = true
SMTP_SERVICE = 'gmail'

# JWT
ACCESS_TOKEN_SECRET = 'secret'
REFRESH_TOKEN_SECRET = 'refresh'
TOKEN_EXPIRATION_HOURS = 8

# Space-separated list of allowed `CORS` origins
CORS_ORIGIN = 'http://localhost:4200 http://localhost:3000 http://localhost:8100 capacitor://localhost'

# Whether cookies may only be sent over secure origins. Useful for localhost
# development, where it must be false so cookies are sent to `http` origins.
# In production it must be true, so cookies travel over `https` only.
SECURE_COOKIE = false

# Database (used by TypeORM; Docker Compose overrides this with Postgres URL)
DATABASE_URL = "postgresql://spira:spira_secret@localhost:5432/spira_db"

# TypeORM: `synchronize` creates/updates the schema automatically from the
# entities. Handy in development, but it must be false in production, where the
# schema is managed with migrations (`pnpm migration:run`).
DB_SYNCHRONIZE = true
DB_LOGGING = false

# Docker Compose – Postgres (only needed when using docker-compose)
POSTGRES_USER = spira
POSTGRES_PASSWORD = spira_secret
POSTGRES_DB = spira_db
POSTGRES_PORT = 5433
